#!/usr/bin/env bash
set -euo pipefail

bundle_directory="${1:?Bundle directory is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

version="$(node scripts/verify-release.mjs "$bundle_directory")"
tag="v$version"

if ! gh release view "$tag" >/dev/null 2>&1; then
  mapfile -t assets < <(find "$bundle_directory" -maxdepth 1 -type f -print | sort)
  gh release create "$tag" \
    --target main \
    --latest=false \
    --title "Agents CLI $tag" \
    --notes "Cryptographically verified standalone release of Agents CLI $tag." \
    "${assets[@]}"
fi

published_directory="$(mktemp -d "${RUNNER_TEMP:-/tmp}/agents-cli-published.XXXXXXXX")"
cleanup() {
  case "$published_directory" in
    "${RUNNER_TEMP:-/tmp}"/agents-cli-published.*) rm -rf -- "$published_directory" ;;
  esac
}
trap cleanup EXIT

gh release download "$tag" --dir "$published_directory"
node scripts/verify-release.mjs "$published_directory" --version "$version" >/dev/null

mapfile -t release_tags < <(
  gh release list --limit 100 --json tagName,isDraft,isPrerelease \
    --jq '.[] | select(.isDraft == false and .isPrerelease == false) | .tagName' |
    grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' |
    sort -Vu
)
if test "${#release_tags[@]}" -gt 0; then
  gh release edit "${release_tags[-1]}" --latest
fi
